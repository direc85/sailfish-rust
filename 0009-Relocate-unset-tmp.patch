From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matti Viljanen <matti.viljanen@jolla.com>
Date: Sat, 22 Jun 2024 11:30:30 +0300
Subject: [PATCH] Relocate unset tmp

In Linux, unset $TMPDIR defaults to /tmp. In sb2 the temp files written to /tmp
by rustc are no longer available when the linker tries to use them. Work around
the issue by setting $TMPDIR to $HOME/.tmp when determining the temporary
directory location whenever linking is determined to happen.

If $TMPDIR is already set, that value is used as expected.
---
 compiler/rustc_codegen_ssa/src/back/link.rs | 23 +++++++++++++++++++--
 1 file changed, 21 insertions(+), 2 deletions(-)

diff --git a/compiler/rustc_codegen_ssa/src/back/link.rs b/compiler/rustc_codegen_ssa/src/back/link.rs
index 388503c72..5e6a768e6 100644
--- a/compiler/rustc_codegen_ssa/src/back/link.rs
+++ b/compiler/rustc_codegen_ssa/src/back/link.rs
@@ -5,7 +5,7 @@ use std::ffi::OsString;
 use std::fs::{File, OpenOptions, read};
 use std::io::{BufReader, BufWriter, Write};
 use std::ops::{ControlFlow, Deref};
-use std::path::{Path, PathBuf};
+use std::path::{MAIN_SEPARATOR_STR, Path, PathBuf};
 use std::process::{Output, Stdio};
 use std::{env, fmt, fs, io, mem, str};
 
@@ -110,12 +110,31 @@ pub fn link_binary(
                 outputs,
                 codegen_results.crate_info.local_crate_name,
             );
+            let mut clear_tmp = false;
+            if env::var_os("TMPDIR").is_none()
+                && let Some(mut home_tmp) = env::var_os("HOME")
+            {
+                use std::str::FromStr;
+                home_tmp.push(OsString::from_str(MAIN_SEPARATOR_STR).unwrap());
+                home_tmp.push(OsString::from_str(".tmp").unwrap());
+                unsafe {
+                    env::set_var("TMPDIR", &home_tmp);
+                }
+                if !Path::new(&home_tmp).exists() {
+                    let _ = fs::create_dir_all(Path::new(&home_tmp));
+                }
+                clear_tmp = true;
+            }
             let tmpdir = TempDirBuilder::new()
                 .prefix("rustc")
                 .tempdir_in(output.parent().unwrap_or_else(|| Path::new(".")))
                 .unwrap_or_else(|error| sess.dcx().emit_fatal(errors::CreateTempDir { error }));
             let path = MaybeTempDir::new(tmpdir, sess.opts.cg.save_temps);
-
+            if clear_tmp {
+                unsafe {
+                    env::remove_var("TMP");
+                }
+            }
             let crate_name = format!("{}", codegen_results.crate_info.local_crate_name);
             let out_filename = output.file_for_writing(
                 outputs,
